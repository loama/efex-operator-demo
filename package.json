{
  "name": "efex-operator-demo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun run --cwd apps/api dev",
    "dev:app": "bun run --cwd apps/mobile start",
    "ios": "bun run --cwd apps/mobile ios",
    "web": "bun run --cwd apps/mobile web",
    "test:api": "bun run --cwd apps/api test",
    "test:contracts": "bun run --cwd packages/contracts test",
    "test:mobile": "bun run --cwd apps/mobile test",
    "test": "bun run test:contracts && bun run test:api && bun run test:mobile",
    "typecheck": "bun run --cwd packages/contracts typecheck && bun run --cwd apps/api typecheck && bun run --cwd apps/mobile typecheck",
    "lint": "bun run --cwd apps/mobile lint",
    "build:web": "bun run --cwd apps/mobile build:web"
  }
}
