{
  "expo": {
    "name": "EFEX",
    "slug": "efex-operator-demo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/efex-icon.png",
    "scheme": "efex",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/efex-icon.png",
      "bundleIdentifier": "com.efex.operatordemo"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/images/efex-mark-transparent.png",
        "monochromeImage": "./assets/images/efex-mark-transparent.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/efex-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111111",
          "image": "./assets/images/efex-wordmark.png",
          "imageWidth": 118
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
